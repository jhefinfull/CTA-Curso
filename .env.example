# Base da API pública da loja do CTA no AcadGSD.
GSD_API_BASE_URL=https://cta-cursos.acadgsd.com/api/public/v1

# Token da escola (painel do CTA › Configurações › API do site). Fica só no servidor:
# nunca prefixe com NEXT_PUBLIC_.
GSD_API_TOKEN=

# Opcional: para onde o formulário de contato manda os dados (webhook que aceite JSON).
# Sem ele, o formulário abre o WhatsApp do CTA com a mensagem pronta.
CONTATO_WEBHOOK_URL=
